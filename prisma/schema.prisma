// Prisma Schema for Nexa Capital Enterprise Platform (Phase 5 Admin & CMS Edition)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  FINANCE
  SUPPORT
  EDITOR
  USER
  GUEST
}

enum TicketCategory {
  DEPOSIT
  WITHDRAWAL
  INVESTMENT
  ACCOUNT
  OTHER
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum AnnouncementStatus {
  PUBLISHED
  SCHEDULED
  DRAFT
  ARCHIVED
}

enum InvestmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model User {
  id                      String    @id @default(uuid())
  fullName                String
  username                String    @unique
  email                   String    @unique
  phone                   String
  passwordHash            String
  avatarUrl               String?
  country                 String    @default("Indonesia")
  language                String    @default("id")
  timezone                String    @default("Asia/Jakarta")
  dateFormat              String    @default("DD/MM/YYYY")
  currency                String    @default("IDR")
  isEmailVerified         Boolean   @default(false)
  referralCode            String    @unique
  referredByCode          String?
  vipLevel                String    @default("VIP 0")
  saldoPenarikan          Float     @default(0.0)
  saldoProfit             Float     @default(0.0)
  totalInvested           Float     @default(0.0)
  totalProfitEarned       Float     @default(0.0)
  totalReferralCommission Float     @default(0.0)
  failedLoginAttempts     Int       @default(0)
  isLockedOut             Boolean   @default(false)
  lockoutUntil            DateTime?
  lastLoginAt             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  roles              UserRole[]
  sessions           Session[]
  loginHistories     LoginHistory[]
  emailVerifications EmailVerification[]
  passwordResets     PasswordReset[]
  refreshTokens      RefreshToken[]
  investments        Investment[]
  transactions       Transaction[]
  notifications      Notification[]
  wallets            Wallet?
  walletLedgers      WalletLedger[]
  supportTickets     SupportTicket[]
  auditLogs          AuditLog[]
  depositRequests    DepositRequest[]
  withdrawalRequests WithdrawalRequest[]
  financialLedgers   FinancialLedger[]
  paymentAccounts    UserPaymentAccount[]
  aiConversations    AiConversation[]

  @@index([email])
  @@index([username])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        RoleName @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  token        String   @unique
  ipAddress    String
  userAgent    String
  deviceName   String
  isCurrent    Boolean  @default(true)
  isValid      Boolean  @default(true)
  expiresAt    DateTime
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model LoginHistory {
  id            String   @id @default(uuid())
  userId        String
  ipAddress     String
  userAgent     String
  location      String?
  deviceType    String
  status        String
  failureReason String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("login_history")
}

model EmailVerification {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verifications")
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model InvestmentProduct {
  id                String   @id @default(uuid())
  name              String
  category          String
  description       String
  price             Float
  minInvest         Float
  maxInvest         Float
  durationDays      Int
  dailyReturnPct    Float
  totalProfitTarget Float
  riskLevel         String   @default("MEDIUM")
  imageUrl          String
  displayOrder      Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  investments Investment[]

  @@map("investment_products")
}

model Investment {
  id                String           @id @default(uuid())
  userId            String
  productId         String
  productName       String
  productCategory   String
  productImage      String
  amountInvested    Float
  dailyProfit       Float
  totalProfitTarget Float
  profitEarned      Float            @default(0.0)
  daysElapsed       Int              @default(0)
  totalDays         Int
  remainingDays     Int
  riskLevel         String           @default("LOW")
  status            InvestmentStatus @default(ACTIVE)
  isLockable35H     Boolean          @default(false)
  purchaseDate      DateTime         @default(now())
  completedDate     DateTime?
  lastProfitClaimAt DateTime?

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   InvestmentProduct    @relation(fields: [productId], references: [id], onDelete: Cascade)
  schedules InvestmentSchedule[]

  @@index([userId])
  @@map("investments")
}

model InvestmentSchedule {
  id           String    @id @default(uuid())
  investmentId String
  dayNumber    Int
  expectedDate DateTime
  profitAmount Float
  status       String    @default("PENDING") // PENDING, CLAIMED, MISSED
  claimedAt    DateTime?

  investment Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  @@index([investmentId])
  @@map("investment_schedule")
}

model PortfolioSummary {
  id                       String   @id @default(uuid())
  userId                   String   @unique
  totalValue               Float    @default(0.0)
  totalProfit              Float    @default(0.0)
  activeInvestmentsCount   Int      @default(0)
  completedInvestmentsCount Int      @default(0)
  assetAllocationJson      String   @default("{}")
  growthHistoryJson        String   @default("[]")
  updatedAt                DateTime @updatedAt

  @@map("portfolio_summary")
}

model Transaction {
  id          String   @id @default(uuid())
  userId      String
  type        String // "DEPOSIT" | "WITHDRAWAL" | "PRODUCT_PURCHASE" | "DAILY_PROFIT" | "REFERRAL_COMMISSION"
  amount      Float
  fee         Float    @default(0.0)
  status      String // "APPROVED" | "SUCCESS" | "PENDING" | "REJECTED"
  note        String
  referenceNo String   @unique
  date        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([referenceNo])
  @@map("transactions")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  category  String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

model Wallet {
  id             String   @id @default(uuid())
  userId         String   @unique
  mainWallet     Float    @default(0.0)
  profitWallet   Float    @default(0.0)
  referralWallet Float    @default(0.0)
  bonusWallet    Float    @default(0.0)
  cashbackWallet Float    @default(0.0)
  isFrozen       Boolean  @default(false)
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model WalletLedger {
  id         String   @id @default(uuid())
  userId     String
  fromWallet String
  toWallet   String
  amount     Float
  note       String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("wallet_ledgers")
}

model CMSContent {
  id             String   @id @default("default_cms")
  heroTitle      String
  heroSubtitle   String
  bannerText     String
  bannerActive   Boolean  @default(true)
  faqsJson       String   @default("[]")
  newsJson       String   @default("[]")
  socialLinksJson String  @default("{}")
  termsOfService String
  privacyPolicy  String
  contactEmail   String
  contactPhone   String
  companyAddress String
  updatedAt      DateTime @updatedAt

  @@map("cms_contents")
}

model Announcement {
  id          String             @id @default(uuid())
  title       String
  content     String
  category    String             @default("GENERAL")
  status      AnnouncementStatus @default(PUBLISHED)
  publishedAt DateTime?
  createdAt   DateTime           @default(now())

  @@map("announcements")
}

model SupportTicket {
  id            String         @id @default(uuid())
  userId        String
  userName      String
  userEmail     String
  subject       String
  category      TicketCategory
  priority      TicketPriority @default(MEDIUM)
  status        TicketStatus   @default(OPEN)
  assignedStaff String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies SupportReply[]

  @@index([userId])
  @@map("support_tickets")
}

model SupportReply {
  id         String   @id @default(uuid())
  ticketId   String
  sender     String // "USER" | "STAFF" | "SYSTEM"
  senderName String
  message    String
  createdAt  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("support_replies")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  userEmail String
  action    String
  module    String
  details   String
  ipAddress String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("audit_logs")
}

model SystemLog {
  id        String   @id @default(uuid())
  level     String // "INFO" | "WARN" | "ERROR"
  message   String
  source    String
  stack     String?
  createdAt DateTime @default(now())

  @@map("system_logs")
}

model SystemSettings {
  id                String   @id @default("default_settings")
  appName           String
  brandTagline      String
  logoUrl           String
  faviconUrl        String
  defaultTheme      String   @default("DARK")
  smtpHost          String
  smtpPort          Int      @default(587)
  smtpUser          String
  timezone          String   @default("Asia/Jakarta")
  currency          String   @default("IDR")
  language          String   @default("id")
  isMaintenanceMode Boolean  @default(false)
  maintenanceReason String?
  updatedAt         DateTime @updatedAt

  @@map("system_settings")
}

model FileAsset {
  id         String   @id @default(uuid())
  name       String
  url        String
  sizeBytes  Int
  mimeType   String
  folder     String   @default("general")
  uploadedBy String
  createdAt  DateTime @default(now())

  @@map("file_assets")
}

model PaymentProvider {
  id         String   @id @default(uuid())
  code       String   @unique // MIDTRANS, XENDIT, STRIPE, PAYPAL, MANUAL, CRYPTO
  name       String
  type       String   @default("AUTOMATED") // AUTOMATED, MANUAL, CRYPTO
  isActive   Boolean  @default(true)
  configJson String   @default("{}")

  methods PaymentMethod[]

  @@map("payment_providers")
}

model PaymentMethod {
  id               String          @id @default(uuid())
  providerId       String
  code             String          @unique // VA_BCA, VA_MANDIRI, QRIS, BANK_TRANSFER, CC, EWALLET_GOPAY, CRYPTO_USDT
  name             String
  category         String          // BANK_TRANSFER, VIRTUAL_ACCOUNT, QR_CODE, CREDIT_CARD, EWALLET, CRYPTO, MANUAL
  iconUrl          String?
  minAmount        Float           @default(10000.0)
  maxAmount        Float           @default(100000000.0)
  adminFee         Float           @default(0.0)
  adminFeeType     String          @default("FIXED") // FIXED or PERCENTAGE
  isActive         Boolean         @default(true)
  instructionsJson String          @default("[]")

  provider PaymentProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("payment_methods")
}

model DepositRequest {
  id                String   @id @default(uuid())
  userId            String
  referenceNo       String   @unique
  amount            Float
  adminFee          Float    @default(0.0)
  totalAmount       Float
  paymentMethodCode String
  providerCode      String
  status            String   @default("WAITING_PAYMENT") // WAITING_PAYMENT, PENDING, PROCESSING, SUCCESS, FAILED, EXPIRED, CANCELLED
  paymentUrl        String?
  vaNumber          String?
  qrCodeUrl         String?
  bankName          String?
  accountNumber     String?
  accountName       String?
  receiptUrl        String?
  adminNotes        String?
  approvedAt        DateTime?
  expiredAt         DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([referenceNo])
  @@map("deposit_requests")
}

model WithdrawalRequest {
  id            String    @id @default(uuid())
  userId        String
  referenceNo   String    @unique
  amount        Float
  adminFee      Float     @default(0.0)
  netAmount     Float
  bankName      String
  accountNumber String
  accountName   String
  otpVerified   Boolean   @default(false)
  status        String    @default("PENDING") // PENDING, PROCESSING, APPROVED, REJECTED, CANCELLED
  adminNotes    String?
  approvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([referenceNo])
  @@map("withdrawal_requests")
}

model FinancialLedger {
  id            String   @id @default(uuid())
  userId        String
  type          String   // DEBIT, CREDIT
  amount        Float
  balanceBefore Float
  balanceAfter  Float
  walletType    String   @default("MAIN") // MAIN, PROFIT, REFERRAL, BONUS, CASHBACK
  referenceNo   String
  description   String
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([referenceNo])
  @@map("financial_ledger")
}

model PaymentWebhook {
  id           String   @id @default(uuid())
  providerCode String
  event        String
  payloadJson  String
  signature    String?
  isProcessed  Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@map("payment_webhooks")
}

model BankAccount {
  id            String  @id @default(uuid())
  bankName      String
  bankCode      String
  accountNumber String
  accountHolder String
  qrCodeUrl     String?
  isActive      Boolean @default(true)

  @@map("bank_accounts")
}

model UserPaymentAccount {
  id            String   @id @default(uuid())
  userId        String
  type          String   // BANK, EWALLET, CRYPTO
  providerName  String   // BCA, Mandiri, GoPay, USDT TRC20
  accountNumber String
  accountHolder String
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_payment_accounts")
}

model Announcement {
  id           String    @id @default(uuid())
  title        String
  content      String
  targetRole   String    @default("ALL") // ALL, USER, ADMIN, VIP
  priority     String    @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  status       String    @default("PUBLISHED") // DRAFT, PUBLISHED, ARCHIVED
  scheduledFor DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("announcements")
}

model Report {
  id          String   @id @default(uuid())
  title       String
  category    String   // REVENUE, INVESTMENT, WALLET, TRANSACTION, REFERRAL, REWARD, USER, SYSTEM
  rangeType   String   // DAILY, WEEKLY, MONTHLY, QUARTERLY, YEARLY, CUSTOM
  summaryJson String   @default("{}")
  generatedBy String   @default("SYSTEM")
  createdAt   DateTime @default(now())

  @@map("reports")
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  module    String
  details   String
  ipAddress String   @default("127.0.0.1")
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("activity_logs")
}

model SystemLog {
  id           String   @id @default(uuid())
  level        String   @default("INFO") // INFO, WARN, ERROR
  message      String
  service      String   @default("API")
  metadataJson String   @default("{}")
  createdAt    DateTime @default(now())

  @@map("system_logs")
}

model AiConversation {
  id        String      @id @default(uuid())
  userId    String
  title     String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @default(now()) @updatedAt
  messages  AiMessage[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("ai_conversations")
}

model AiMessage {
  id             String   @id @default(uuid())
  conversationId String
  role           String   // user, model
  content        String
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ai_messages")
}


